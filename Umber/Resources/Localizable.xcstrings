    "timer.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتلاشى Umber ببطء خلال آخر 20 ثانية ثم يتوقف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber s’esvaeix lentament durant els últims 20 segons i després s’atura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber v posledních 20 sekundách pomalu ztichne a pak se zastaví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber toner langsomt ud i de sidste 20 sekunder og stopper derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber blendet in den letzten 20 Sekunden langsam aus und stoppt dann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Umber σβήνει αργά τα τελευταία 20 δευτερόλεπτα και μετά σταματά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber fades out slowly during the last 20 seconds, then stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber se desvanece despacio durante los últimos 20 segundos y luego se detiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber hiljenee hitaasti viimeisten 20 sekunnin aikana ja pysähtyy sitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber s’estompe lentement pendant les 20 dernières secondes, puis s’arrête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber מתעמעם לאט ב-20 השניות האחרונות ואז נעצר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber आख़िरी 20 सेकंड में धीरे-धीरे धीमा होकर रुक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber se polako stišava u posljednjih 20 sekundi, a zatim staje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Umber az utolsó 20 másodpercben lassan elhalkul, majd leáll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber memudar perlahan selama 20 detik terakhir, lalu berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber sfuma lentamente negli ultimi 20 secondi, poi si ferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Umberは最後の20秒でゆっくりフェードアウトして停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber는 마지막 20초 동안 천천히 페이드 아웃한 후 멈춥니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber pudar perlahan dalam 20 saat terakhir, kemudian berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber tones sakte ut de siste 20 sekundene og stopper deretter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber vervaagt langzaam in de laatste 20 seconden en stopt dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber powoli wycisza się w ostatnich 20 sekundach, a potem się zatrzymuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Umber diminui o volume devagar nos últimos 20 segundos e depois para."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Umber esbate lentamente nos últimos 20 segundos e depois para."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber se estompează lent în ultimele 20 de secunde, apoi se oprește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber плавно затихает в последние 20 секунд, а затем останавливается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber v posledných 20 sekundách pomaly stíchne a potom sa zastaví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber tonar ut långsamt under de sista 20 sekunderna och stannar sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber จะค่อย ๆ เบาลงใน 20 วินาทีสุดท้าย แล้วหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber son 20 saniyede yavaşça kısılır ve sonra durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber повільно стихає в останні 20 секунд, а потім зупиняється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nhỏ dần trong 20 giây cuối rồi dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber 会在最后 20 秒缓缓淡出，然后停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber 會在最後 20 秒緩緩淡出，然後停止。"
          }
        }
      }
    },
