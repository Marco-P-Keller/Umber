    "settings.promise": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا إعلانات ولا حسابات ولا تتبّع. يعمل Umber دون اتصال بالكامل، ويُولَّد كل صوت مباشرةً على جهازك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense anuncis, sense comptes, sense seguiment. Umber funciona totalment sense connexió i cada so es genera en directe al teu dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné reklamy, žádné účty, žádné sledování. Umber funguje zcela offline a každý zvuk se generuje živě ve vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen reklamer, ingen konti, ingen sporing. Umber virker helt offline, og hver lyd skabes live på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung, keine Konten, kein Tracking. Umber funktioniert komplett offline, und jeder Klang wird live auf deinem Gerät erzeugt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς διαφημίσεις, χωρίς λογαριασμούς, χωρίς παρακολούθηση. Το Umber λειτουργεί εντελώς εκτός σύνδεσης και κάθε ήχος παράγεται ζωντανά στη συσκευή σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no accounts, no tracking. Umber works completely offline, and every sound is generated live on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios, sin cuentas, sin seguimiento. Umber funciona sin conexión y cada sonido se genera en directo en tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mainoksia, ei tilejä, ei seurantaa. Umber toimii täysin offline-tilassa, ja jokainen ääni luodaan livenä laitteellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni publicité, ni compte, ni suivi. Umber fonctionne entièrement hors ligne et chaque son est généré en direct sur votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי פרסומות, בלי חשבונות, בלי מעקב. Umber פועל לגמרי ללא חיבור, וכל צליל נוצר בזמן אמת במכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न विज्ञापन, न अकाउंट, न ट्रैकिंग। Umber पूरी तरह ऑफ़लाइन चलता है और हर ध्वनि आपके डिवाइस पर लाइव बनती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez oglasa, bez računa, bez praćenja. Umber radi potpuno izvan mreže, a svaki se zvuk generira uživo na tvom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs reklám, nincs fiók, nincs követés. Az Umber teljesen offline működik, és minden hang élőben készül az eszközödön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa iklan, tanpa akun, tanpa pelacakan. Umber bekerja sepenuhnya offline, dan setiap suara dibuat langsung di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente pubblicità, niente account, nessun tracciamento. Umber funziona completamente offline e ogni suono viene generato dal vivo sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告なし、アカウントなし、トラッキングなし。Umberは完全オフラインで動作し、すべての音はデバイス上でリアルタイムに生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고도, 계정도, 추적도 없습니다. Umber는 완전히 오프라인으로 작동하며 모든 소리는 기기에서 실시간으로 생성됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada iklan, tiada akaun, tiada penjejakan. Umber berfungsi sepenuhnya luar talian dan setiap bunyi dijana secara langsung pada peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen reklame, ingen kontoer, ingen sporing. Umber fungerer helt uten nett, og hver lyd lages live på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen advertenties, geen accounts, geen tracking. Umber werkt volledig offline en elk geluid wordt live op je apparaat gegenereerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez reklam, bez kont, bez śledzenia. Umber działa w pełni offline, a każdy dźwięk jest generowany na żywo na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios, sem contas, sem rastreamento. O Umber funciona totalmente offline e cada som é gerado ao vivo no seu aparelho."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios, sem contas, sem rastreio. O Umber funciona totalmente offline e cada som é gerado em direto no seu dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără reclame, fără conturi, fără urmărire. Umber funcționează complet offline, iar fiecare sunet este generat live pe dispozitivul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без рекламы, без аккаунтов, без слежки. Umber работает полностью офлайн, а каждый звук создаётся прямо на вашем устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne reklamy, žiadne účty, žiadne sledovanie. Umber funguje úplne offline a každý zvuk sa generuje naživo vo vašom zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga annonser, inga konton, ingen spårning. Umber fungerar helt offline och varje ljud skapas live på din enhet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีโฆษณา ไม่มีบัญชี ไม่มีการติดตาม Umber ทำงานออฟไลน์ได้เต็มที่ และทุกเสียงถูกสร้างสดบนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam yok, hesap yok, izleme yok. Umber tamamen çevrimdışı çalışır ve her ses cihazında canlı üretilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без реклами, без облікових записів, без стеження. Umber працює повністю офлайн, а кожен звук створюється наживо на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không quảng cáo, không tài khoản, không theo dõi. Umber hoạt động hoàn toàn ngoại tuyến và mọi âm thanh đều được tạo trực tiếp trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无广告、无账户、无跟踪。Umber 完全离线运行，每一种声音都在你的设备上实时生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有廣告、沒有帳號、沒有追蹤。Umber 完全離線運作，每種聲音都在你的裝置上即時生成。"
          }
        }
      }
    },
