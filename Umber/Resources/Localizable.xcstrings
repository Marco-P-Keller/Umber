    "settings.mix.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك الموسيقى أو البودكاست يعمل تحت Umber."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que la música o un pòdcast sonin per sota d’Umber."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte hrát hudbu nebo podcast pod Umberem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad musik eller en podcast spille under Umber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Musik oder einen Podcast unter Umber weiterlaufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άφησε μουσική ή podcast να παίζει κάτω από το Umber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep music or a podcast playing underneath Umber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén música o un pódcast sonando por debajo de Umber."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna musiikin tai podcastin soida Umberin alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez de la musique ou un podcast en fond sous Umber."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר מוזיקה או פודקאסט מתנגנים מתחת ל-Umber."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत या पॉडकास्ट को Umber के नीचे चलता रहने दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka glazba ili podcast sviraju ispod Umbera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd, hogy zene vagy podcast szóljon az Umber alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan musik atau podcast tetap berputar di bawah Umber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia musica o un podcast in sottofondo sotto Umber."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
