    "error.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Umber بدء محرّك الصوت. أغلق تطبيقات الصوت الأخرى وحاول مجددًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber no ha pogut iniciar el motor d’àudio. Tanca les altres apps d’àudio i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nemohl spustit zvukový modul. Zavřete ostatní zvukové aplikace a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber kunne ikke starte lydmotoren. Luk andre lydapps, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber konnte die Audio-Engine nicht starten. Beende andere Audio-Apps und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Umber δεν μπόρεσε να ξεκινήσει τη μηχανή ήχου. Κλείσε άλλες εφαρμογές ήχου και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber couldn't start the audio engine. Close other audio apps and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber no pudo iniciar el motor de audio. Cierra otras apps de audio e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber ei voinut käynnistää äänimoottoria. Sulje muut ääniappit ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber n’a pas pu démarrer le moteur audio. Fermez les autres apps audio et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber לא הצליח להפעיל את מנוע השמע. סגור אפליקציות שמע אחרות ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber ऑडियो इंजन शुरू नहीं कर सका। दूसरे ऑडियो ऐप बंद करके फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nije mogao pokrenuti audio mehanizam. Zatvori druge audio aplikacije i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Umber nem tudta elindítani a hangmotort. Zárd be a többi hangalkalmazást, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber tidak dapat memulai mesin audio. Tutup aplikasi audio lain dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber non è riuscito ad avviare il motore audio. Chiudi le altre app audio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Umberはオーディオエンジンを起動できませんでした。他のオーディオアプリを閉じて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber가 오디오 엔진을 시작하지 못했습니다. 다른 오디오 앱을 종료하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber tidak dapat memulakan enjin audio. Tutup apl audio lain dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber kunne ikke starte lydmotoren. Lukk andre lydapper og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber kon de audio-engine niet starten. Sluit andere audio-apps en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nie mógł uruchomić silnika audio. Zamknij inne aplikacje audio i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Umber não conseguiu iniciar o mecanismo de áudio. Feche outros apps de áudio e tente de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Umber não conseguiu iniciar o motor de áudio. Feche outras apps de áudio e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nu a putut porni motorul audio. Închide celelalte aplicații audio și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber не удалось запустить аудиодвижок. Закройте другие аудиоприложения и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber nedokázal spustiť zvukový modul. Zatvorte ostatné zvukové aplikácie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber kunde inte starta ljudmotorn. Stäng andra ljudappar och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber เริ่มเอนจินเสียงไม่ได้ ปิดแอปเสียงอื่นแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber ses motorunu başlatamadı. Diğer ses uygulamalarını kapatıp tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber не вдалося запустити аудіодвигун. Закрийте інші аудіододатки й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber không thể khởi động công cụ âm thanh. Hãy đóng các ứng dụng âm thanh khác và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber 无法启动音频引擎。请关闭其他音频 App 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Umber 無法啟動音訊引擎。請關閉其他音訊 App 後再試一次。"
          }
        }
      }
    },
